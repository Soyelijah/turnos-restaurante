{
  "name": "garzon-turnos-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=127.0.0.1 --port=3000",
    "dev:lan": "vite --host=0.0.0.0 --port=3000",
    "build": "vite build",
    "preview": "vite preview --host=127.0.0.1 --port=4173",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:frontend && npm run check:backend && npm run check:contract",
    "check:frontend": "npm run lint && npm test && npm run build",
    "check:backend": "composer --working-dir=backend validate --strict && composer --working-dir=backend audit && composer --working-dir=backend analyse && composer --working-dir=backend test",
    "check:contract": "redocly lint docs/api/openapi.yaml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "2.47.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
